{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nekolog-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",

  // Local development settings
  "dev": {
    "port": 8787
  },

  // D1 Database binding
  // For local development, wrangler creates a local SQLite database
  // For production, replace database_id with actual D1 database ID
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nekolog-db",
      "database_id": "local"
    }
  ],

  // R2 Bucket binding for cat image storage
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "nekolog-images"
    }
  ],

  // Environment variables
  // Secrets (set via `wrangler secret put`):
  //   - BETTER_AUTH_SECRET
  // Vars:
  "vars": {
    "PUBLIC_BUCKET_URL": "http://localhost:8787/images",
    "BETTER_AUTH_URL": "http://localhost:8787"
  },

  // Production environment overrides
  "env": {
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nekolog-db",
          "database_id": "dd8a7f08-831a-4f09-9b89-14db4e545ccf"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "nekolog-images"
        }
      ],
      "vars": {
        "PUBLIC_BUCKET_URL": "PUBLIC_BUCKET_URL_HERE",
        "BETTER_AUTH_URL": "BETTER_AUTH_URL_HERE"
      }
    }
  }
}
